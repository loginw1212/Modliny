080</token><Color3uint8 name="Color">2813047039</Color3uint8><float name="ChannelCount">0</float><token name="Shape">1</token><float name="Transparency">0</float><bool name="CanCollide">false</bool><Vector3 name="Size"><X>7.5</X><Y>0.8</Y><Z>2</Z></Vector3><float name="Reflectance">0</float><CoordinateFrame name="CFrame"><X>-390</X><Y>16.0</Y><Z>284.2</Z><R00>1.000000</R00><R01>0.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.000000</R20><R21>0.000000</R21><R22>1.000000</R22></CoordinateFrame><Vector3 name="Velocity"><X>0</X><Y>0</Y><Z>0</Z></Vector3></Properties></Item><Item class="Part" referent="RBX296"><Properties><string name="Name">Barierka</string><bool name="Anchored">true</bool><float name="BottomSurface">0</float><float name="TopSurface">0</float><token name="Material">1080</token><Color3uint8 name="Color">4072806911</Color3uint8><float name="ChannelCount">0</float><token name="Shape">1</token><float name="Transparency">0</float><bool name="CanCollide">true</bool><Vector3 name="Size"><X>7.5</X><Y>0.6</Y><Z>0.4</Z></Vector3><float name="Reflectance">0</float><CoordinateFrame name="CFrame"><X>-390</X><Y>17.4</Y><Z>294.6</Z><R00>1.000000</R00><R01>0.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.000000</R20><R21>0.000000</R21><R22>1.000000</R22></CoordinateFrame><Vector3 name="Velocity"><X>0</X><Y>0</Y><Z>0</Z></Vector3></Properties></Item><Item class="Part" referent="RBX297"><Properties><string name="Name">Kolo-3.4_3</string><bool name="Anchored">true</bool><float name="BottomSurface">0</float><float name="TopSurface">0</float><token name="Material">1080</token><Color3uint8 name="Color">522265855</Color3uint8><float name="ChannelCount">0</float><token name="Shape">2</token><float name="Transparency">0</float><bool name="CanCollide">true</bool><Vector3 name="Size"><X>1.2</X><Y>2.4</Y><Z>2.4</Z></Vector3><float name="Reflectance">0</float><CoordinateFrame name="CFrame"><X>-393.4</X><Y>2.7</Y><Z>299</Z><R00>1.000000</R00><R01>0.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.000000</R20><R21>0.000000</R21><R22>1.000000</R22></CoordinateFrame><Vector3 name="Velocity"><X>0</X><Y>0</Y><Z>0</Z></Vector3></Properties></Item><Item class="Part" referent="RBX298"><Properties><string name="Name">Kolo-3.4_-3</string><bool name="Anchored">true</bool><float name="BottomSurface">0</float><float name="TopSurface">0</float><token name="Material">1080</token><Color3uint8 name="Color">522265855</Color3uint8><float name="ChannelCount">0</float><token name="Shape">2</token><float name="Transparency">0</float><bool name="CanCollide">true</bool><Vector3 name="Size"><X>1.2</X><Y>2.4</Y><Z>2.4</Z></Vector3><float name="Reflectance">0</float><CoordinateFrame name="CFrame"><X>-393.4</X><Y>2.7</Y><Z>293</Z><R00>1.000000</R00><R01>0.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.000000</R20><R21>0.000000</R21><R22>1.000000</R22></CoordinateFrame><Vector3 name="Velocity"><X>0</X><Y>0</Y><Z>0</Z></Vector3></Properties></Item><Item class="Part" referent="RBX299"><Properties><string name="Name">Kolo3.4_3</string><bool name="Anchored">true</bool><float name="BottomSurface">0</float><float name="TopSurface">0</float><token name="Material">1080</token><Color3uint8 name="Color">522265855</Color3uint8><float name="ChannelCount">0</float><token name="Shape">2</token><float name="Transparency">0</float><bool name="CanCollide">true</bool><Vector3 name="Size"><X>1.2</X><Y>2.4</Y><Z>2.4</Z></Vector3><float name="Reflectance">0</float><CoordinateFrame name="CFrame"><X>-386.6</X><Y>2.7</Y><Z>299</Z><R00>1.000000</R00><R01>0.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.000000</R20><R21>0.000000</R21><R22>1.000000</R22></CoordinateFrame><Vector3 name="Velocity"><X>0</X><Y>0</Y><Z>0</Z></Vector3></Properties></Item><Item class="Part" referent="RBX300"><Properties><string name="Name">Kolo3.4_-3</string><bool name="Anchored">true</bool><float name="BottomSurface">0</float><float name="TopSurface">0</float><token name="Material">1080</token><Color3uint8 name="Color">522265855</Color3uint8><float name="ChannelCount">0</float><token name="Shape">2</token><float name="Transparency">0</float><bool name="CanCollide">true</bool><Vector3 name="Size"><X>1.2</X><Y>2.4</Y><Z>2.4</Z></Vector3><float name="Reflectance">0</float><CoordinateFrame name="CFrame"><X>-386.6</X><Y>2.7</Y><Z>293</Z><R00>1.000000</R00><R01>0.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.000000</R20><R21>0.000000</R21><R22>1.000000</R22></CoordinateFrame><Vector3 name="Velocity"><X>0</X><Y>0</Y><Z>0</Z></Vector3></Properties></Item><Item class="Script" referent="RBX307"><Properties><string name="Name">Pojazd_Sterowanie</string><bool name="Disabled">false</bool><string name="Source">-- POJAZDY OBSLUGI NAZIEMNEJ: sterowanie + automatyczne trasy
-- Wejdz na siedzenie = sterujesz (W/S gaz, A/D kierownica). Zejscie = powrot na miejsce postoju.
-- Trasa patrolowa: atrybut "Route" modelu, format "x1,z1;x2,z2;..."

local model = script.Parent
local chassis = model:WaitForChild("Chassis")
local seat = model:WaitForChild("Kierowca")

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local parkedCFrame = chassis.CFrame
local WELDED = false
local driving = false
local routeIdx = 1
local yaw = select(2, chassis.CFrame:ToOrientation())

local function weldAll()
	if WELDED then return end
	WELDED = true
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p ~= chassis then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = chassis
			weld.Part1 = p
			weld.Parent = chassis
		end
	end
end
weldAll()

local bodyVel = Instance.new("BodyVelocity")
bodyVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
bodyVel.Velocity = Vector3.zero
bodyVel.Parent = chassis

local gyro = Instance.new("BodyGyro")
gyro.MaxTorque = Vector3.new(3e6, 3e6, 3e6)
gyro.P = 4000
gyro.D = 400
gyro.CFrame = chassis.CFrame
gyro.Parent = chassis

local function parseRoute(attr)
	local pts = {}
	if type(attr) == "string" and attr ~= "" then
		for token in string.gmatch(attr, "[^;]+") do
			local x, z = string.match(token, "(-?%d+%.?%d*)%s*,%s*(-?%d+%.?%d*)")
			if x and z then
				table.insert(pts, Vector3.new(tonumber(x), 0, tonumber(z)))
			end
		end
	end
	return pts
end

local route = parseRoute(model:GetAttribute("Route"))
if #route == 0 then
	local DEFAULTS = {
		FollowMe = "-330,150;300,150;-330,150",
		Bagazowka = "-330,240;100,242;-330,240",
	}
	route = parseRoute(DEFAULTS[model.Name] or "")
end
local speed = 0

seat:GetPropertyChangedSignal("Occupant"):Connect(function()
	if seat.Occupant then
		driving = true
		weldAll()
		chassis.Anchored = false
		gyro.CFrame = chassis.CFrame
		yaw = select(2, chassis.CFrame:ToOrientation())
		speed = 0
	else
		driving = false
		bodyVel.Velocity = Vector3.zero
		task.wait(2)
		if not driving then
			chassis.Anchored = true
			model:PivotTo(parkedCFrame)
			yaw = select(2, chassis.CFrame:ToOrientation())
		end
	end
end)

RunService.Heartbeat:Connect(function(dt)
	if model:GetAttribute("Servicing") then return end

	if driving then
		local throttle = seat.Throttle
		local steer = seat.Steer
		local maxSpd = tonumber(model:GetAttribute("MaxSpeed")) or 26
		local target = 0
		if throttle &gt; 0 then
			target = throttle * maxSpd
		elseif throttle &lt; 0 then
			target = math.max(speed + throttle * 60 * dt, -maxSpd * 0.4)
		end
		speed = speed + (target - speed) * math.clamp(dt * 4, 0, 1)
		if math.abs(speed) &gt; 0.5 then
			yaw -= steer * dt * 1.5 * math.clamp(math.abs(speed) / 10, 0.4, 1) * (speed &gt;= 0 and 1 or -1)
		end
		gyro.CFrame = CFrame.Angles(0, yaw, 0)
		local forward = -gyro.CFrame.LookVector
		bodyVel.Velocity = forward * speed
	elseif chassis.Anchored and #route &gt; 0 then
		local target = route[routeIdx]
		local pos = chassis.Position
		local flat = Vector3.new(target.X - pos.X, 0, target.Z - pos.Z)
		if flat.Magnitude &lt; 3 then
			routeIdx = routeIdx % #route + 1
			return
		end
		local dir = flat.Unit
		local targetYaw = math.atan2(-dir.X, -dir.Z)
		local step = math.min(tonumber(model:GetAttribute("PatrolSpeed")) or 12, flat.Magnitude) * dt
		yaw = targetYaw
		model:PivotTo(CFrame.new(pos + dir * step, pos + dir * step + dir))
	end
end)
</string></Properties></Item></Item></Item><Item class="Model" referent="RBX308"><Properties><string name="Name">Zarzadca</string></Properties><Item class="Script" referent="RBX309"><Properties><string name="Name">Bramki_System</string><bool name="Disabled">false</bool><string name="Source">-- SYSTEM BRAMEK (GATE SYSTEM) Lotnisko Modlin
-- - czujniki styania A1..A4: lapia samolot, przelaczaja tablice ZAJETA/WOLNA
-- - automatyczne drzwi terminala (ProximityPrompt)
-- - tablica odlotow

local lotnisko = workspace:WaitForChild("Lotnisko_Modlin_WMI")
local TerminalService = game:GetService("TweenService")

local stands = {}
for _, gate in ipairs(lotnisko:WaitForChild("Bramki"):GetChildren()) do
	local sensor = gate:FindFirstChild("Czujnik")
	local sign = gate:FindFirstChild("Tabliczka", true)
	if sensor then
		stands[gate.Name] = {sensor = sensor, sign = sign, busy = false}
	end
end

local function setText(label, text, color)
	if label and label:IsA("TextLabel") then
		label.Text = text
		label.TextColor3 = color
	end
end

task.spawn(function()
	while true do
		for name, st in pairs(stands) do
			local busy = false
			for _, m in ipairs(workspace:GetChildren()) do
				if m:IsA("Model") and m.Name:find("Boeing") then
					local pp = m.PrimaryPart or m:FindFirstChild("Main")
					if pp and (pp.Position - st.sensor.Position).Magnitude &lt; 70 then
						busy = true
					end
				end
			end
			if busy ~= st.busy then
				st.busy = busy
				if busy then
					setText(st.sign, name .. " ZAJETA", Color3.fromRGB(255, 80, 80))
				else
					setText(st.sign, name .. " WOLNA", Color3.fromRGB(80, 255, 120))
				end
			end
		end
		task.wait(2)
	end
end)

-- drzwi terminala
local drzwi = lotnisko:FindFirstChild("Terminal")
if drzwi then
	for _, d in ipairs(drzwi:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			d.Triggered:Connect(function()
				local left = d.Parent:FindFirstChild("Lewa")
				local right = d.Parent:FindFirstChild("Prawa")
				local function slide(part, x)
					if not part then return end
					local tw = TerminalService:Create(part, TweenInfo.new(0.8, Enum.EasingStyle.Quad), {CFrame = part.CFrame * CFrame.new(x, 0, 0)})
					tw:Play()
				end
				slide(left, -6)
				slide(right, 6)
				task.delay(4, function()
					slide(left, 6)
					slide(right, -6)
				end)
			end)
		end
	end
end
</string></Properties></Item><Item class="Script" referent="RBX310"><Properties><string name="Name">Operacje_Naziemne</string><bool name="Disabled">false</bool><string name="Source">-- OBSLUGA NAZIEMNA (RAMP) - automatyczna petla na bramce A1:
-- schody -&gt; autobus -&gt; bagazowka -&gt; tankowoz

local lotnisko = workspace:WaitForChild("Lotnisko_Modlin_WMI")
local pojazdy = lotnisko:WaitForChild("Pojazdy")
local samolot = lotnisko:WaitForChild("Boeing737_WMI_100")

local GATE = Vector3.new(-150, 0, 260)

local function busy(v)
	return v:GetAttribute("PlayerDriving") ~= nil
end

local function moveTo(vehicle, target, s)
	local pos = vehicle:GetPivot().Position
	local flat = Vector3.new(target.X - pos.X, 0, target.Z - pos.Z)
	local dist = flat.Magnitude
	if dist &lt; 2 then return end
	local dir = flat.Unit
	local t = 0
	while t &lt; dist / s do
		t += task.wait()
		if busy(vehicle) then return false end
		local p = pos + dir * s * math.min(t, dist / s)
		vehicle:PivotTo(CFrame.new(p.X, pos.Y, p.Z))
	end
	vehicle:PivotTo(CFrame.new(target.X, pos.Y, target.Z))
	return true
end

local function serve(vehicle, targetPos, waitTime, s)
	if busy(vehicle) then return end
	vehicle:SetAttribute("Servicing", true)
	local homeCf = vehicle:GetPivot()
	local home = Vector3.new(homeCf.X, 0, homeCf.Z)
	if moveTo(vehicle, targetPos, s or 16) then
		task.wait(waitTime)
		if not busy(vehicle) then moveTo(vehicle, home, s or 16) end
	end
	vehicle:SetAttribute("Servicing", nil)
end

local function offset(x, z)
	return GATE + Vector3.new(x, 0, z)
end

while true do
	task.wait(25)

	local planeMain = samolot and samolot:FindFirstChild("Main")
	if planeMain and (planeMain.Position - GATE).Magnitude &lt; 80 then
		serve(pojazdy:FindFirstChild("Schody"), offset(14, 32), 12, 14)
		serve(pojazdy:FindFirstChild("Bus"), offset(-16, 40), 10)
		serve(pojazdy:FindFirstChild("Bagazowka"), offset(-20, -12), 8)
		serve(pojazdy:FindFirstChild("Tankowoz"), offset(34, -10), 8, 12)
	end
end
</string></Properties></Item><Item class="Script" referent="RBX311"><Properties><string name="Name">Oswietlenie</string><bool name="Disabled">false</bool><string name="Source">-- OSWIETLENIE LOTNISKA: lampy podejsciowe (rabbit), latarnia PAPI, beacon wiezy, krawedzie pasa

local lotnisko = workspace:WaitForChild("Lotnisko_Modlin_WMI")
local oswietlenie = lotnisko:WaitForChild("Oswietlenie")

local strobes = {}
for i = 1, 8 do
	local s = oswietlenie:FindFirstChild("Podejscie" .. i)
	if s then table.insert(strobes, s) end
end
local papi = {}
for i = 1, 4 do
	local p = oswietlenie:FindFirstChild("PAPI" .. i)
	if p then table.insert(papi, p) end
end
local beacon = oswietlenie:FindFirstChild("Beacon")
local krawedzie = {}
for _, e in ipairs(oswietlenie:GetChildren()) do
	if e.Name:sub(1, 4) == "Kraw" then table.insert(krawedzie, e) end
end

task.spawn(function() -- sekwencja podejsciowa (rabbit)
	while true do
		for _, s in ipairs(strobes) do
			s.Material = Enum.Material.Neon
			s.Color = Color3.fromRGB(255, 255, 255)
			task.wait(0.09)
			s.Material = Enum.Material.SmoothPlastic
			s.Color = Color3.fromRGB(120, 120, 120)
		end
		task.wait(0.9)
	end
end)

task.spawn(function() -- PAPI: 2 biale / 2 czerwone
	while true do
		for _, p in ipairs(papi) do
			local num = tonumber(p.Name:sub(-1)) or 0
			p.Color = num &lt;= 2 and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 40, 40)
		end
		task.wait(2)
		for _, p in ipairs(papi) do
			p.Color = Color3.fromRGB(255, 255, 255)
		end
		task.wait(2)
	end
end)

task.spawn(function() -- wieza: naprzemiennie zielony/bialy
	local white = true
	while true do
		if beacon then
			beacon.Color = white and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(40, 255, 90)
		end
		white = not white
		task.wait(0.5)
	end
end)

task.spawn(function() -- krawedzie pasa: fala swiatla
	local lit = true
	while true do
		for i, e in ipairs(krawedzie) do
			if lit or i % 2 == 1 then
				e.Material = Enum.Material.Neon
				e.Color = Color3.fromRGB(255, 230, 160)
			else
				e.Material = Enum.Material.SmoothPlastic
				e.Color = Color3.fromRGB(110, 110, 110)
			end
		end
		lit = not lit
		task.wait(0.45)
	end
end)
</string></Properties></Item></Item></Item></roblox>