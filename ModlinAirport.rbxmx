</string></Properties></Item></Item></Item><Item class="Model" referent="RBX502"><Properties><string name="Name">Zarzadca</string></Properties><Item class="Script" referent="RBX503"><Properties><string name="Name">Bramki_System</string><bool name="Disabled">false</bool><string name="Source">-- SYSTEM BRAMEK (GATE SYSTEM) Lotnisko Modlin
-- - czujniki styania A1..A4: lapia samolot, przelaczaja tablice ZAJETA/WOLNA
-- - automatyczne drzwi terminala (ProximityPrompt)
-- - tablica odlotow

local lotnisko = workspace:WaitForChild("Lotnisko_Modlin_WMI")
local TerminalService = game:GetService("TweenService")

local stands = {}
for _, gate in ipairs(lotnisko:WaitForChild("Bramki"):GetChildren()) do
	local sensor = gate:FindFirstChild("Czujnik")
	local sign = gate:FindFirstChild("Tabliczka", true)
	if sensor then
		stands[gate.Name] = {sensor = sensor, sign = sign, busy = false}
	end
end

local function setText(label, text, color)
	if label and label:IsA("TextLabel") then
		label.Text = text
		label.TextColor3 = color
	end
end

task.spawn(function()
	while true do
		for name, st in pairs(stands) do
			local busy = false
			for _, m in ipairs(workspace:GetChildren()) do
				if m:IsA("Model") and m.Name:find("Boeing") then
					local pp = m.PrimaryPart or m:FindFirstChild("Main")
					if pp and (pp.Position - st.sensor.Position).Magnitude &lt; 70 then
						busy = true
					end
				end
			end
			if busy ~= st.busy then
				st.busy = busy
				if busy then
					setText(st.sign, name .. " ZAJETA", Color3.fromRGB(255, 80, 80))
				else
					setText(st.sign, name .. " WOLNA", Color3.fromRGB(80, 255, 120))
				end
			end
		end
		task.wait(2)
	end
end)

-- drzwi terminala
local drzwi = lotnisko:FindFirstChild("Terminal")
if drzwi then
	for _, d in ipairs(drzwi:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			d.Triggered:Connect(function()
				local left = d.Parent:FindFirstChild("Lewa")
				local right = d.Parent:FindFirstChild("Prawa")
				local function slide(part, x)
					if not part then return end
					local tw = TerminalService:Create(part, TweenInfo.new(0.8, Enum.EasingStyle.Quad), {CFrame = part.CFrame * CFrame.new(x, 0, 0)})
					tw:Play()
				end
				slide(left, -6)
				slide(right, 6)
				task.delay(4, function()
					slide(left, 6)
					slide(right, -6)
				end)
			end)
		end
	end
end
</string></Properties></Item><Item class="Script" referent="RBX504"><Properties><string name="Name">Operacje_Naziemne</string><bool name="Disabled">false</bool><string name="Source">-- OBSLUGA NAZIEMNA (RAMP) - automatyczna petla na bramce A1:
-- schody -&gt; autobus -&gt; bagazowka -&gt; tankowoz

local lotnisko = workspace:WaitForChild("Lotnisko_Modlin_WMI")
local pojazdy = lotnisko:WaitForChild("Pojazdy")
local samolot = lotnisko:WaitForChild("Boeing737_WMI_100")

local GATE = Vector3.new(-150, 0, 260)

local function busy(v)
	return v:GetAttribute("PlayerDriving") ~= nil
end

local function moveTo(vehicle, target, s)
	local pos = vehicle:GetPivot().Position
	local flat = Vector3.new(target.X - pos.X, 0, target.Z - pos.Z)
	local dist = flat.Magnitude
	if dist &lt; 2 then return end
	local dir = flat.Unit
	local t = 0
	while t &lt; dist / s do
		t += task.wait()
		if busy(vehicle) then return false end
		local p = pos + dir * s * math.min(t, dist / s)
		vehicle:PivotTo(CFrame.new(p.X, pos.Y, p.Z))
	end
	vehicle:PivotTo(CFrame.new(target.X, pos.Y, target.Z))
	return true
end

local function serve(vehicle, targetPos, waitTime, s)
	if busy(vehicle) then return end
	vehicle:SetAttribute("Servicing", true)
	local homeCf = vehicle:GetPivot()
	local home = Vector3.new(homeCf.X, 0, homeCf.Z)
	if moveTo(vehicle, targetPos, s or 16) then
		task.wait(waitTime)
		if not busy(vehicle) then moveTo(vehicle, home, s or 16) end
	end
	vehicle:SetAttribute("Servicing", nil)
end

local function offset(x, z)
	return GATE + Vector3.new(x, 0, z)
end

while true do
	task.wait(25)

	local planeMain = samolot and samolot:FindFirstChild("Main")
	if planeMain and (planeMain.Position - GATE).Magnitude &lt; 80 then
		serve(pojazdy:FindFirstChild("Schody"), offset(14, 32), 12, 14)
		serve(pojazdy:FindFirstChild("Bus"), offset(-16, 40), 10)
		serve(pojazdy:FindFirstChild("Bagazowka"), offset(-20, -12), 8)
		serve(pojazdy:FindFirstChild("Tankowoz"), offset(34, -10), 8, 12)
		serve(pojazdy:FindFirstChild("BeltLoader"), offset(-26, -6), 8, 12)
		serve(pojazdy:FindFirstChild("Catering"), offset(-2, -26), 8, 12)
	end
end
</string></Properties></Item><Item class="Script" referent="RBX505"><Properties><string name="Name">Oswietlenie</string><bool name="Disabled">false</bool><string name="Source">-- OSWIETLENIE LOTNISKA: lampy podejsciowe (rabbit), latarnia PAPI, beacon wiezy, krawedzie pasa

local lotnisko = workspace:WaitForChild("Lotnisko_Modlin_WMI")
local oswietlenie = lotnisko:WaitForChild("Oswietlenie")

local strobes = {}
for i = 1, 8 do
	local s = oswietlenie:FindFirstChild("Podejscie" .. i)
	if s then table.insert(strobes, s) end
end
local papi = {}
for i = 1, 4 do
	local p = oswietlenie:FindFirstChild("PAPI" .. i)
	if p then table.insert(papi, p) end
end
local beacon = oswietlenie:FindFirstChild("Beacon")
local krawedzie = {}
for _, e in ipairs(oswietlenie:GetChildren()) do
	if e.Name:sub(1, 4) == "Kraw" then table.insert(krawedzie, e) end
end

task.spawn(function() -- sekwencja podejsciowa (rabbit)
	while true do
		for _, s in ipairs(strobes) do
			s.Material = Enum.Material.Neon
			s.Color = Color3.fromRGB(255, 255, 255)
			task.wait(0.09)
			s.Material = Enum.Material.SmoothPlastic
			s.Color = Color3.fromRGB(120, 120, 120)
		end
		task.wait(0.9)
	end
end)

task.spawn(function() -- PAPI: 2 biale / 2 czerwone
	while true do
		for _, p in ipairs(papi) do
			local num = tonumber(p.Name:sub(-1)) or 0
			p.Color = num &lt;= 2 and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 40, 40)
		end
		task.wait(2)
		for _, p in ipairs(papi) do
			p.Color = Color3.fromRGB(255, 255, 255)
		end
		task.wait(2)
	end
end)

task.spawn(function() -- wieza: naprzemiennie zielony/bialy
	local white = true
	while true do
		if beacon then
			beacon.Color = white and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(40, 255, 90)
		end
		white = not white
		task.wait(0.5)
	end
end)

task.spawn(function() -- krawedzie pasa: fala swiatla
	local lit = true
	while true do
		for i, e in ipairs(krawedzie) do
			if lit or i % 2 == 1 then
				e.Material = Enum.Material.Neon
				e.Color = Color3.fromRGB(255, 230, 160)
			else
				e.Material = Enum.Material.SmoothPlastic
				e.Color = Color3.fromRGB(110, 110, 110)
			end
		end
		lit = not lit
		task.wait(0.45)
	end
end)
</string></Properties></Item><Item class="Script" referent="RBX506"><Properties><string name="Name">Ruch_Pasazerow</string><bool name="Disabled">false</bool><string name="Source">-- RUCH PASAZEROW: chodzacy pasazerowie na plycie (autobus &lt;-&gt; schody &lt;-&gt; terminal)

local lotnisko = workspace:WaitForChild("Lotnisko_Modlin_WMI")
local grupa = lotnisko:WaitForChild("Pasazerowie")

local Y = 4.2
local trasy = {
	{Vector3.new(-140, Y, 292), Vector3.new(-173, Y, 285), Vector3.new(-140, Y, 292)},
	{Vector3.new(-150, Y, 296), Vector3.new(-173, Y, 300), Vector3.new(-150, Y, 296)},
	{Vector3.new(-190, Y, 332), Vector3.new(-140, Y, 292), Vector3.new(-190, Y, 332)},
	{Vector3.new(-190, Y, 332), Vector3.new(-150, Y, 296), Vector3.new(-190, Y, 332)},
}

local i = 0
for _, p in ipairs(grupa:GetChildren()) do
	i += 1
	local trasa = trasy[i] or trasy[1]
	local idx = 1
	local speed = 5 + i
	task.spawn(function()
		while true do
			local pos = p:GetPivot().Position
			local cel = trasa[idx]
			local flat = Vector3.new(cel.X - pos.X, 0, cel.Z - pos.Z)
			if flat.Magnitude &lt; 2 then
				idx = idx % #trasa + 1
				task.wait(math.random() * 2)
			else
				local dir = flat.Unit
				local step = math.min(speed * 0.05, flat.Magnitude)
				task.wait(0.05)
				p:PivotTo(CFrame.lookAt(pos + dir * step, pos + dir * step + dir))
			end
		end
	end)
end
