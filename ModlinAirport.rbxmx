		if math.abs(speed) &gt; 0.5 then
			yaw -= steer * dt * 1.5 * math.clamp(math.abs(speed) / 10, 0.4, 1) * (speed &gt;= 0 and 1 or -1)
		end
		gyro.CFrame = CFrame.Angles(0, yaw, 0)
