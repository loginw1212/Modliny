><Vector3 name="Velocity"><X>0</X><Y>0</Y><Z>0</Z></Vector3></Properties></Item><Item class="Part" referent="RBX236"><Properties><string name="Name">PodwozieMKoloP</string><bool name="Anchored">true</bool><float name="BottomSurface">0</float><float name="TopSurface">0</float><token name="Material">1080</token><Color3uint8 name="Color">589637631</Color3uint8><float name="ChannelCount">0</float><token name="Shape">1</token><float name="Transparency">0</float><bool name="CanCollide">false</bool><Vector3 name="Size"><X>6.4</X><Y>2.6</Y><Z>2.6</Z></Vector3><float name="Reflectance">0</float><CoordinateFrame name="CFrame"><X>-138</X><Y>2.6</Y><Z>241</Z><R00>1.000000</R00><R01>0.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.000000</R20><R21>0.000000</R21><R22>1.000000</R22></CoordinateFrame><Vector3 name="Velocity"><X>0</X><Y>0</Y><Z>0</Z></Vector3></Properties></Item></Item><Item class="Model" referent="RBX237"><Properties><string name="Name">Klapy</string></Properties><Item class="Part" referent="RBX238"><Properties><string name="Name">KlapaL</string><bool name="Anchored">true</bool><float name="BottomSurface">0</float><float name="TopSurface">0</float><token name="Material">1080</token><Color3uint8 name="Color">3385643263</Color3uint8><float name="ChannelCount">0</float><token name="Shape">1</token><float name="Transparency">1</float><bool name="CanCollide">false</bool><Vector3 name="Size"><X>50</X><Y>0.7</Y><Z>4</Z></Vector3><float name="Reflectance">0</float><CoordinateFrame name="CFrame"><X>-183</X><Y>9.2</Y><Z>244</Z><R00>0.978148</R00><R01>0.000000</R01><R02>-0.207912</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.207912</R20><R21>0.000000</R21><R22>0.978148</R22></CoordinateFrame><Vector3 name="Velocity"><X>0</X><Y>0</Y><Z>0</Z></Vector3></Properties></Item><Item class="Part" referent="RBX239"><Properties><string name="Name">KlapaP</string><bool name="Anchored">true</bool><float name="BottomSurface">0</float><float name="TopSurface">0</float><token name="Material">1080</token><Color3uint8 name="Color">3385643263</Color3uint8><float name="ChannelCount">0</float><token name="Shape">1</token><float name="Transparency">1</float><bool name="CanCollide">false</bool><Vector3 name="Size"><X>50</X><Y>0.7</Y><Z>4</Z></Vector3><float name="Reflectance">0</float><CoordinateFrame name="CFrame"><X>-117</X><Y>9.2</Y><Z>244</Z><R00>0.978148</R00><R01>0.000000</R01><R02>0.207912</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>-0.207912</R20><R21>0.000000</R21><R22>0.978148</R22></CoordinateFrame><Vector3 name="Velocity"><X>0</X><Y>0</Y><Z>0</Z></Vector3></Properties></Item></Item><Item class="VehicleSeat" referent="RBX240"><Properties><string name="Name">PilotSeat</string><bool name="Anchored">true</bool><float name="BottomSurface">0</float><float name="TopSurface">0</float><token name="Material">256</token><Color3uint8 name="Color">288579583</Color3uint8><float name="ChannelCount">0</float><float name="Transparency">0</float><bool name="CanCollide">true</bool><Vector3 name="Size"><X>3</X><Y>1</Y><Z>3.5</Z></Vector3><float name="Reflectance">0</float><CoordinateFrame name="CFrame"><X>-150</X><Y>17.4</Y><Z>302</Z><R00>1.000000</R00><R01>0.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.000000</R20><R21>0.000000</R21><R22>1.000000</R22></CoordinateFrame><Vector3 name="Velocity"><X>0</X><Y>0</Y><Z>0</Z></Vector3><float name="MaxSpeed">0</float><float name="Torque">0</float><float name="TurnSpeed">0</float><bool name="HeadsUpDisplay">false</bool></Properties></Item><Item class="Part" referent="RBX241"><Properties><string name="Name">KokpitPodest</string><bool name="Anchored">true</bool><float name="BottomSurface">0</float><float name="TopSurface">0</float><token name="Material">1080</token><Color3uint8 name="Color">3099378431</Color3uint8><float name="ChannelCount">0</float><token name="Shape">1</token><float name="Transparency">0</float><bool name="CanCollide">true</bool><Vector3 name="Size"><X>7</X><Y>7</Y><Z>0.4</Z></Vector3><float name="Reflectance">0</float><CoordinateFrame name="CFrame"><X>-150</X><Y>16.6</Y><Z>302</Z><R00>1.000000</R00><R01>0.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.000000</R20><R21>0.000000</R21><R22>1.000000</R22></CoordinateFrame><Vector3 name="Velocity"><X>0</X><Y>0</Y><Z>0</Z></Vector3></Properties></Item><Item class="Script" referent="RBX493"><Properties><string name="Name">Samolot_Lot</string><bool name="Disabled">false</bool><string name="Source">-- SAMOLOT: Boeing 737-800 (Lotnisko Modlin / WMI)
-- Sterowanie: W/S = przepustnica, A/D = ster kierunkowy
-- Komendy na czacie: /gear (podwozie), /flaps (klapy), /brakes (hamowanie), /reset (poziomowanie)

local model = script.Parent
local root = model:WaitForChild("Main")
local seat = model:WaitForChild("PilotSeat")

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local headYaw = 0
local roll = 0
local GROUND_Y = 10
local gearDown = true
local flaps = false
local flying = false
local speed = 0
local WELDED = false
local pilot = nil

local function weldAll()
	if WELDED then return end
	WELDED = true
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p ~= root then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = p
			weld.Parent = root
		end
	end
end
weldAll()
headYaw = select(2, root.CFrame:ToOrientation())

local bodyVel = Instance.new("BodyVelocity")
bodyVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
bodyVel.Velocity = Vector3.zero
bodyVel.Parent = root

local gyro = Instance.new("BodyGyro")
gyro.MaxTorque = Vector3.new(4e6, 4e6, 4e6)
gyro.P = 6000
gyro.D = 500
gyro.CFrame = root.CFrame
gyro.Parent = root

local function setGear(down)
	gearDown = down
	local gear = model:FindFirstChild("Podwozie")
	if gear then
		for _, g in ipairs(gear:GetChildren()) do
			if g:IsA("BasePart") then g.Transparency = down and 0.25 or 1 end
		end
	end
end

local function setFlaps(on)
	flaps = on
	local f = model:FindFirstChild("Klapy")
	if f then
		for _, p in ipairs(f:GetChildren()) do
			if p:IsA("BasePart") then p.Transparency = on and 0.1 or 1 end
		end
	end
end

Players.PlayerAdded:Connect(function(plr)
	plr.Chatted:Connect(function(msg)
		if plr ~= pilot then return end
		local cmd = string.lower(msg):gsub("%s+", "")
		if cmd == "/gear" then
			setGear(not gearDown)
		elseif cmd == "/flaps" then
			setFlaps(not flaps)
		elseif cmd == "/brakes" then
			speed = 0
		elseif cmd == "/reset" and not flying then
			root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, headYaw, 0)
		end
	end)
end)

seat:GetPropertyChangedSignal("Occupant"):Connect(function()
	if seat.Occupant then
		pilot = Players:GetPlayerFromCharacter(seat.Occupant and seat.Occupant.Parent or nil)
		flying = true
		weldAll()
		root.Anchored = false
		bodyVel.Velocity = Vector3.zero
		gyro.CFrame = root.CFrame
	else
		pilot = nil
		flying = false
		bodyVel.Velocity = Vector3.zero
		task.wait(1.5)
		if not flying then
			root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, headYaw, 0)
			root.Anchored = true
		end
	end
end)

RunService.Heartbeat:Connect(function(dt)
	if not flying then return end
	local throttle = seat.Throttle
	local steer = seat.Steer

	local maxSpd = 235
	if flaps then maxSpd = maxSpd * 0.8 end

	local target = 0
	if throttle &gt; 0 then
		target = 45 + throttle * (maxSpd - 45)
	elseif throttle &lt; 0 then
		target = math.max(speed + throttle * 250 * dt, 0)
	end
	local accel = (target &gt; speed) and 0.35 or 1.2
	speed = speed + (target - speed) * math.clamp(dt * accel, 0, 1)
	if math.abs(speed) &lt; 0.4 and target == 0 then speed = 0 end

	if speed &gt; 4 then
		headYaw -= steer * dt * (1.2 - math.clamp(speed / 420, 0, 0.8))
	end
	local localRoll = -steer * math.clamp(speed / 150, 0, 1) * 24
	roll = roll + (localRoll - roll) * math.clamp(dt * 3, 0, 1)

	local vy = 0
	local pos = root.Position
	if pos.Y &lt;= GROUND_Y + 1 then
		if speed &gt; 82 then
			vy = math.clamp((speed - 82) / 90, 0, 1) * 55 + (flaps and 12 or 0)
		else
			vy = 0
			speed = speed * 0.995
		end
		if throttle &lt; 0 then speed = math.max(speed - 140 * dt, 0) end
	else
		if speed &gt; 82 then
			vy = math.clamp((speed - 82) / 90, 0, 1) * 45 + (flaps and 10 or 0)
		elseif speed &lt; 58 then
			vy = flaps and -13 or -19
		end
	end
	if pos.Y &lt;= GROUND_Y and vy &lt;= 0 then
		vy = 0
		root.CFrame = CFrame.new(Vector3.new(pos.X, GROUND_Y, pos.Z)) * CFrame.Angles(0, headYaw, 0)
	end

	local pitch = math.clamp(vy, 0, 45) * 0.22
	gyro.CFrame = CFrame.Angles(0, headYaw, 0) * CFrame.Angles(math.rad(-pitch), 0, math.rad(roll))
	local forward = -gyro.CFrame.LookVector
	bodyVel.Velocity = forward * speed + Vector3.new(0, vy, 0)
end)
